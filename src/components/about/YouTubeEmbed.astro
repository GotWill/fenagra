---
import { getYouTubeEmbedUrl } from '../../data/video';

interface Props {
	youtubeId: string;
	title: string;
	class?: string;
}

const { youtubeId, title, class: className } = Astro.props;
const embedUrl = getYouTubeEmbedUrl(youtubeId);
---

<div class:list={['stage', className]}>
	<iframe
		class="iframe"
		src={embedUrl}
		title={title}
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
		allowfullscreen
		referrerpolicy="strict-origin-when-cross-origin"
		loading="lazy"
	></iframe>
</div>

<style>
	.stage {
		position: relative;
		height: 100%;
	}

	.iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
