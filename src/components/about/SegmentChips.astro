---
interface Props {
	items?: string[];
	class?: string;
}

const { items = [], class: className } = Astro.props;
---

<ul role="list" class:list={['chips', className]}>
	{items.map((item) => <li>{item}</li>)}
</ul>

<style>
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.chips li {
		padding: 8px 14px;
		border-radius: var(--r-pill);
		background: #fff;
		border: 1px solid var(--fen-line);
		font-size: 13px;
		font-weight: 500;
		color: var(--fen-green-900);
	}
</style>
