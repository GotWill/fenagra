---
export type ButtonVariant = 'primary' | 'accent' | 'ink' | 'outline' | 'outline-dark';
export type ButtonSize = 'sm' | 'md' | 'lg';

interface Props {
	variant?: ButtonVariant;
	size?: ButtonSize;
	href?: string;
	type?: 'button' | 'submit' | 'reset';
	iconDiagonal?: boolean;
	class?: string;
	[key: string]: unknown;
}

const {
	variant = 'primary',
	size = 'md',
	href,
	type = 'button',
	iconDiagonal = false,
	class: className,
	...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const hasIcon = Astro.slots.has('icon');
---

<Tag
	class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
	href={href}
	type={href ? undefined : type}
	{...rest}
>
	<slot />
	{
		hasIcon && (
			<span class:list={['ic', { diag: iconDiagonal }]}>
				<slot name="icon" />
			</span>
		)
	}
</Tag>

<style>
	.btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		isolation: isolate;
		overflow: hidden;
		height: 50px;
		padding: 0 22px;
		border-radius: var(--r-pill);
		border: none;
		font-family: var(--fen-font);
		font-size: 14px;
		font-weight: 600;
		line-height: 1;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out),
			background-color var(--dur) var(--ease-out),
			color var(--dur) var(--ease-out),
			border-color var(--dur) var(--ease-out);
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	.btn:active {
		transform: translateY(0) scale(0.97);
		transition-duration: var(--dur-press);
	}

	.btn:focus-visible {
		outline: 3px solid var(--fen-accent);
		outline-offset: 3px;
	}

	.btn--sm {
		height: 48px;
	}

	.btn--lg {
		height: 56px;
		padding: 0 32px;
		font-size: 15px;
	}

	.btn--primary {
		background: var(--fen-green-900);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--fen-green-950);
		box-shadow: var(--sh-btn-dark);
	}

	.btn--accent {
		background: var(--fen-accent);
		color: var(--fen-green-950);
	}

	.btn--accent:hover {
		background: var(--accent-hover);
		box-shadow: var(--sh-btn-accent);
	}

	.btn--ink {
		background: var(--fen-green-950);
		color: #fff;
	}

	.btn--ink:hover {
		background: var(--fen-green-900);
		box-shadow: var(--sh-btn-dark);
	}

	.btn--outline {
		background: transparent;
		border: 1.5px solid var(--fen-green-900);
		color: var(--fen-green-900);
	}

	.btn--outline:hover {
		background: var(--fen-green-900);
		color: #fff;
	}

	.btn--outline-dark {
		background: transparent;
		border: 1.5px solid var(--fen-green-sage);
		color: #fff;
	}

	.btn--outline-dark:hover {
		background: rgba(228, 236, 160, 0.12);
		border-color: var(--fen-lime-mist);
		color: var(--fen-lime-mist);
	}

	.btn--primary::after,
	.btn--accent::after,
	.btn--ink::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(105deg, transparent 30%, rgba(228, 236, 160, 0.22) 50%, transparent 70%);
		transform: translateX(-130%);
		transition: transform var(--dur-slow) var(--ease-out);
	}

	.btn--accent::after {
		background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.38) 50%, transparent 70%);
	}

	.btn--primary:hover::after,
	.btn--accent:hover::after,
	.btn--ink:hover::after {
		transform: translateX(130%);
	}

	.ic {
		display: inline-flex;
		flex-shrink: 0;
		transition: transform var(--dur) var(--ease-spring);
	}

	.btn:hover .ic {
		transform: translateX(4px);
	}

	.btn:hover .ic.diag {
		transform: translate(3px, -3px);
	}

	@media (prefers-reduced-motion: reduce) {
		.btn:hover,
		.btn:active {
			transform: none;
		}

		.btn--primary::after,
		.btn--accent::after,
		.btn--ink::after {
			display: none;
		}
	}
</style>
