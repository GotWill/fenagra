---
import Icon from '../ui/Icon.astro';
import { quickLinks } from '../../data/quickLinks';
---

<section class="quicklinks" aria-label="Atalhos">
	<div class="wrap">
		<div class="grid">
			{
				quickLinks.map((item) => (
					<a href={item.href} class="card">
						<span class="back" style={`--plate:${item.plate}`} />
						<span class="front">
							<span class="ic">
								<Icon name={item.icon} size={24} strokeWidth={1.8} />
							</span>
							<span class="lb">{item.label}</span>
							<span class="foot">
								<svg
									class="arrow"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M7 17L17 7M9 7h8v8" />
								</svg>
							</span>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.quicklinks {
		background: #fff;
		padding: 88px 0;
	}

	.wrap {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 34px;
	}

	.card {
		position: relative;
		text-decoration: none;
		color: inherit;
		display: block;
	}

	.back {
		position: absolute;
		inset: 14px -14px -14px 14px;
		border-radius: 20px;
		background: var(--plate);
		transition: transform 420ms var(--ease-spring);
	}

	.card:hover .back {
		transform: translate(6px, 6px);
	}

	.front {
		position: relative;
		z-index: 1;
		background: var(--fen-cream);
		border-radius: 20px;
		padding: 26px;
		min-height: 190px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		transition:
			transform 420ms var(--ease-spring),
			box-shadow 220ms var(--ease-out);
	}

	.card:hover .front {
		transform: translate(-6px, -6px);
		box-shadow: 0 18px 32px -20px rgba(15, 30, 14, 0.35);
	}

	.ic {
		width: 52px;
		height: 52px;
		border-radius: var(--r-pill);
		background: #fff;
		color: var(--fen-green-900);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 1px 0 rgba(15, 30, 14, 0.06);
	}

	.lb {
		font-size: 18px;
		font-weight: 600;
		color: var(--fen-green-900);
		margin-top: 16px;
	}

	.foot {
		display: flex;
		justify-content: flex-end;
		margin-top: 14px;
	}

	.arrow {
		color: var(--fen-green-900);
		transition: transform 220ms var(--ease-spring);
	}

	.card:hover .arrow {
		transform: rotate(45deg);
	}

	@media (max-width: 980px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.grid {
			grid-template-columns: 1fr;
		}

		.card {
			padding-right: 6px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back,
		.front,
		.arrow {
			transition-duration: 1ms !important;
		}
	}
</style>
