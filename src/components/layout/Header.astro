---
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import NavDropdown from './NavDropdown.astro';
import LangSwitcher from './LangSwitcher.astro';
import { navigation } from '../../data/navigation';
---

<site-header>
	<header class="header">
		<div class="header-inner">
			<Logo variant="light" />

			<nav class="menu" aria-label="Menu principal">
				{navigation.map((group, i) => <NavDropdown group={group} id={String(i)} />)}
			</nav>

			<div class="right">
				<LangSwitcher />
				<Button variant="accent" size="sm" href="/expor" class="cta">
					Quero expor
					<Icon name="arrow" size={16} slot="icon" />
				</Button>
				<button type="button" class="menu-toggle" data-mobile-menu-trigger aria-label="Abrir menu">
					<Icon name="menu" size={22} />
				</button>
			</div>
		</div>
	</header>
</site-header>

<style>
	site-header {
		display: contents;
	}

	.header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		width: 100%;
		z-index: 60;
		margin: 0;
		padding-top: env(safe-area-inset-top, 0px);
		box-sizing: border-box;
		background: linear-gradient(90deg, rgba(10, 22, 8, 0.5), rgba(15, 30, 12, 0.32) 55%, rgba(20, 38, 15, 0.22));
		backdrop-filter: blur(10px) saturate(165%);
		-webkit-backdrop-filter: blur(10px) saturate(165%);
		border-radius: 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.14);
		box-shadow: none;
		transition:
			background var(--dur) var(--ease-out),
			box-shadow var(--dur) var(--ease-out);
	}

	.header.is-scrolled {
		background: linear-gradient(90deg, rgba(8, 18, 6, 0.68), rgba(12, 26, 10, 0.55) 55%, rgba(18, 34, 13, 0.42));
		box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.4);
		border-bottom-color: rgba(255, 255, 255, 0.1);
	}

	.header-inner {
		height: 92px;
		padding: 0 var(--gutter);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		transition: height var(--dur) var(--ease-out);
	}

	.header.is-scrolled .header-inner {
		height: 76px;
	}

	.menu {
		display: flex;
		gap: 2px;
	}

	.right {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.menu-toggle {
		display: none;
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: var(--r-pill);
		background: var(--fen-green-900);
		color: #fff;
		cursor: pointer;
		transition: transform var(--dur) var(--ease-spring);
	}

	.menu-toggle:hover {
		transform: scale(1.06);
	}

	.menu-toggle:active {
		transform: scale(0.94);
	}

	@media (max-width: 1024px) {
		.menu,
		:global(.lang-item),
		.cta {
			display: none;
		}

		.menu-toggle {
			display: flex;
		}
	}

	@media (max-width: 640px) {
		.header-inner,
		.header.is-scrolled .header-inner {
			height: 72px;
		}
	}
</style>

<script>
	class SiteHeader extends HTMLElement {
		private header!: HTMLElement;
		private onScroll = () => {
			this.header.classList.toggle('is-scrolled', window.scrollY > 24);
		};

		connectedCallback() {
			this.header = this.querySelector('.header')!;
			window.addEventListener('scroll', this.onScroll, { passive: true });
			this.onScroll();
		}

		disconnectedCallback() {
			window.removeEventListener('scroll', this.onScroll);
		}
	}

	customElements.define('site-header', SiteHeader);
</script>
