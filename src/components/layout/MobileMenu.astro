---
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import { navigation } from '../../data/navigation';
---

<mobile-menu>
	<div class="backdrop" data-backdrop hidden></div>

	<div class="panel" data-panel role="dialog" aria-modal="true" aria-label="Menu principal" hidden>
		<div class="menu-head">
			<Logo variant="dark" />
			<button type="button" class="close-btn" data-close aria-label="Fechar menu">
				<Icon name="close" size={22} strokeWidth={2.2} />
			</button>
		</div>

		<div class="drill" data-drill>
			<div class="drill-stack" data-stack>
				<div class="drill-view" data-main>
					{
						navigation.map((group, i) => (
							<button type="button" class="drill-row" data-target={i}>
								<span class="lbl">{group.label}</span>
								<span class="go">
									<Icon name="chevron" size={18} class="rot-right" />
								</span>
							</button>
						))
					}
				</div>
				<div class="drill-view" data-sub></div>
			</div>
		</div>

		{
			navigation.map((group, i) => (
				<template data-sub-template={i}>
					<div class="sub-head">
						<button type="button" class="sub-back" data-back aria-label="Voltar ao menu principal">
							<Icon name="chevron" size={16} class="rot-left" />
						</button>
						<span class="sub-title">{group.label}</span>
					</div>
					{group.links.map((link) => (
						<a href={link.href} class="sub-link">
							<span>{link.title}</span>
							<Icon name="arrow" size={15} />
						</a>
					))}
				</template>
			))
		}

		<div class="menu-foot">
			<Button variant="accent" href="/expor" class="full">
				Quero expor em 2027
				<Icon name="arrow" size={16} slot="icon" />
			</Button>
			<Button variant="outline-dark" href="/credenciamento" class="full">Credenciamento gratuito</Button>
		</div>
	</div>
</mobile-menu>

<style>
	/* ---------- fundo escurecido ---------- */
	.backdrop {
		position: fixed;
		inset: 0;
		z-index: 99;
		background: rgba(10, 18, 8, 0.55);
		backdrop-filter: blur(0px);
		-webkit-backdrop-filter: blur(0px);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--dur-slow, 480ms) var(--ease-out),
			backdrop-filter var(--dur-slow, 480ms) var(--ease-out),
			-webkit-backdrop-filter var(--dur-slow, 480ms) var(--ease-out),
			visibility 0s linear var(--dur-slow, 480ms);
	}

	.backdrop[hidden] {
		display: block; /* controlado por opacity/visibility, não por [hidden], pra poder animar a saída */
	}

	.backdrop.is-open {
		opacity: 1;
		visibility: visible;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		transition-delay: 0s;
	}

	/* ---------- painel (sidebar) ---------- */
	.panel {
		position: fixed;
		inset: 0 auto 0 0;
		width: min(360px, 82vw);
		z-index: 100;
		background: var(--fen-green-950);
		display: flex;
		flex-direction: column;
		transform: translateX(-105%);
		transition: transform var(--dur-slow, 480ms) var(--ease-out);
		box-shadow: 24px 0 48px rgba(0, 0, 0, 0.35);
		padding-top: env(safe-area-inset-top, 0px);
		padding-bottom: env(safe-area-inset-bottom, 0px);
	}

	.panel[hidden] {
		display: flex;
	}

	.panel.is-open {
		transform: translateX(0);
	}

	.menu-head {
		flex-shrink: 0;
		height: 88px;
		padding: 14px 14px 0 20px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.close-btn {
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		border: none;
		border-radius: var(--r-pill);
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		cursor: pointer;
		transition:
			transform var(--dur) var(--ease-spring),
			background-color var(--dur) var(--ease-out);
	}

	.close-btn:hover {
		background: rgba(255, 255, 255, 0.18);
		transform: scale(1.06);
	}

	.close-btn:active {
		transform: scale(0.94);
	}

	/* ---------- drill-down: duas telas, uma desliza sobre a outra ---------- */
	.drill {
		flex: 1;
		overflow: hidden;
		position: relative;
	}

	.drill-stack {
		display: flex;
		width: 200%;
		height: 100%;
		transition: transform var(--dur-slow, 480ms) var(--ease-out);
	}

	.drill.is-sub .drill-stack {
		transform: translateX(-50%);
	}

	.drill-view {
		width: 50%;
		flex-shrink: 0;
		overflow-y: auto;
		padding: 6px 20px 12px;
	}

	.drill-row {
		width: 100%;
		min-height: 66px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 0 6px;
		border: none;
		background: transparent;
		border-bottom: 1px solid var(--fen-green-line);
		cursor: pointer;
		text-align: left;
		transition: background-color var(--dur) var(--ease-out);
	}

	.drill-row:active {
		background: rgba(255, 255, 255, 0.06);
	}

	.drill-row .lbl {
		font-family: var(--fen-font);
		font-weight: 600;
		font-size: 22px;
		letter-spacing: -0.01em;
		color: #fff;
	}

	.drill-row .go {
		width: 30px;
		height: 30px;
		border-radius: var(--r-pill);
		border: 1px solid var(--fen-green-edge);
		color: var(--fen-lime-mist);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.rot-right {
		transform: rotate(-90deg);
	}

	.rot-left {
		transform: rotate(90deg);
	}

	.sub-head {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 2px 6px 18px;
		border-bottom: 1px solid var(--fen-green-line);
		margin-bottom: 8px;
	}

	.sub-back {
		width: 34px;
		height: 34px;
		border-radius: var(--r-pill);
		border: 1px solid var(--fen-green-edge);
		background: transparent;
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		flex-shrink: 0;
	}

	.sub-title {
		font-family: var(--fen-font);
		font-weight: 700;
		font-size: 19px;
		color: #fff;
	}

	.sub-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 56px;
		padding: 0 6px;
		color: #fff;
		text-decoration: none;
		border-bottom: 1px solid var(--fen-green-line);
		font-size: 15.5px;
		font-weight: 500;
		transition:
			padding-left var(--dur) var(--ease-out),
			color var(--dur) var(--ease-out);
	}

	.sub-link:hover {
		padding-left: 10px;
		color: var(--fen-lime-mist);
	}

	.sub-link :global(svg) {
		color: var(--fen-leaf);
		flex-shrink: 0;
	}

	/* ---------- rodapé ---------- */
	.menu-foot {
		flex-shrink: 0;
		padding: 16px 20px 24px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.menu-foot :global(.btn.full) {
		width: 100%;
		height: 54px;
		font-size: 15px;
	}

	@media (prefers-reduced-motion: reduce) {
		.backdrop,
		.panel,
		.drill-stack {
			transition: none !important;
		}
	}
</style>

<script>
	class MobileMenu extends HTMLElement {
		private backdrop!: HTMLDivElement;
		private panel!: HTMLDivElement;
		private closeBtn!: HTMLButtonElement;
		private drill!: HTMLDivElement;
		private subSlot!: HTMLDivElement;
		private triggers: HTMLElement[] = [];
		private lastTrigger: HTMLElement | null = null;
		private lastRow: HTMLElement | null = null;

		private onDocKeydown = (event: KeyboardEvent) => {
			if (this.panel.hidden) return;
			if (event.key === 'Escape') {
				if (this.drill.classList.contains('is-sub')) {
					this.closeSub();
				} else {
					this.close();
				}
				return;
			}
			if (event.key === 'Tab') this.trapFocus(event);
		};

		connectedCallback() {
			this.backdrop = this.querySelector('[data-backdrop]')!;
			this.panel = this.querySelector('[data-panel]')!;
			this.closeBtn = this.querySelector('[data-close]')!;
			this.drill = this.querySelector('[data-drill]')!;
			this.subSlot = this.querySelector('[data-sub]')!;

			this.triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-mobile-menu-trigger]'));
			this.triggers.forEach((trigger) => {
				trigger.addEventListener('click', () => {
					this.lastTrigger = trigger;
					this.open();
				});
			});

			this.closeBtn.addEventListener('click', () => this.close());
			this.backdrop.addEventListener('click', () => this.close());

			this.querySelectorAll<HTMLButtonElement>('.drill-row').forEach((row) => {
				row.addEventListener('click', () => this.openSub(row));
			});

			document.addEventListener('keydown', this.onDocKeydown);
		}

		disconnectedCallback() {
			document.removeEventListener('keydown', this.onDocKeydown);
		}

		open() {
			this.backdrop.hidden = false;
			this.panel.hidden = false;
			document.body.style.overflow = 'hidden';
			requestAnimationFrame(() => {
				this.backdrop.classList.add('is-open');
				this.panel.classList.add('is-open');
				this.closeBtn.focus();
			});
		}

		close() {
			if (this.panel.hidden) return;
			this.backdrop.classList.remove('is-open');
			this.panel.classList.remove('is-open');
			document.body.style.overflow = '';
			this.lastTrigger?.focus();
			window.setTimeout(() => {
				this.backdrop.hidden = true;
				this.panel.hidden = true;
				this.closeSub(true);
			}, 480);
		}

		openSub(row: HTMLButtonElement) {
			const index = row.dataset.target;
			const template = this.querySelector<HTMLTemplateElement>(`template[data-sub-template="${index}"]`);
			if (!template) return;
			this.lastRow = row;
			this.subSlot.replaceChildren(template.content.cloneNode(true));
			this.drill.classList.add('is-sub');
			const backBtn = this.subSlot.querySelector<HTMLButtonElement>('[data-back]');
			backBtn?.addEventListener('click', () => this.closeSub());
			window.setTimeout(() => backBtn?.focus(), 480);
		}

		closeSub(immediate = false) {
			this.drill.classList.remove('is-sub');
			this.lastRow?.focus();
			if (immediate) this.subSlot.replaceChildren();
			else window.setTimeout(() => this.subSlot.replaceChildren(), 480);
		}

		private trapFocus(event: KeyboardEvent) {
			const focusable = Array.from(
				this.panel.querySelectorAll<HTMLElement>(
					'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])',
				),
			).filter((el) => el.offsetParent !== null);
			if (focusable.length === 0) return;
			const first = focusable[0];
			const last = focusable[focusable.length - 1];
			const active = document.activeElement;

			if (event.shiftKey && active === first) {
				event.preventDefault();
				last.focus();
			} else if (!event.shiftKey && active === last) {
				event.preventDefault();
				first.focus();
			}
		}
	}

	customElements.define('mobile-menu', MobileMenu);
</script>
