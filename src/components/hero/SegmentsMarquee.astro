---
import { segments } from '../../data/segments';
---

<div class="marquee">
	<div class="track" tabindex="0" aria-label="Segmentos da feira">
		<ul class="list">
			{
				segments.map((segment) => (
					<li>
						<span class="num">{segment.number}</span>
						<a href={segment.href} class="label">
							{segment.label}
						</a>
						<span class="sep" aria-hidden="true" />
					</li>
				))
			}
		</ul>
		<ul class="list" aria-hidden="true">
			{
				segments.map((segment) => (
					<li>
						<span class="num">{segment.number}</span>
						<span class="label">{segment.label}</span>
						<span class="sep" aria-hidden="true" />
					</li>
				))
			}
		</ul>
	</div>
</div>

<style>
	.marquee {
		position: relative;
		z-index: 1;
		border-top: 1px solid rgba(143, 176, 127, 0.35);
		background: rgba(31, 59, 28, 0.72);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		overflow: hidden;
		padding-bottom: env(safe-area-inset-bottom, 0px);
	}

	.track {
		display: flex;
		width: max-content;
		animation: marquee 48s linear infinite;
	}

	.marquee:hover .track,
	.track:focus-visible,
	.track:focus-within {
		animation-play-state: paused;
	}

	@keyframes marquee {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	.list {
		display: flex;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	li {
		display: flex;
		align-items: center;
		height: 64px;
		padding: 0 24px;
		white-space: nowrap;
		font-size: 15px;
		font-weight: 500;
		color: var(--fen-on-dark);
	}

	.num {
		margin-right: 10px;
		font-size: 13px;
		font-weight: 600;
		color: var(--fen-leaf);
	}

	.label {
		text-decoration: none;
		color: inherit;
	}

	.sep {
		width: 6px;
		height: 6px;
		flex-shrink: 0;
		margin-left: 24px;
		border-radius: 50%;
		background: var(--fen-green-edge);
	}

	@media (max-width: 640px) {
		li {
			height: 56px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
			width: auto;
			flex-wrap: wrap;
		}

		.list[aria-hidden] {
			display: none;
		}

		li {
			white-space: normal;
		}
	}
</style>
