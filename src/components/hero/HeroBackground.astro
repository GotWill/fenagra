---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/images/hero/fenagra-2026-corredor.jpg';
import { event } from '../../data/event';

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['bg', className]} aria-hidden="true">
	<Picture
		src={heroImage}
		formats={['avif', 'webp']}
		alt=""
		layout="full-width"
		priority
		class="photo"
	/>
	<div class="tint"></div>
	<div class="gradient gradient--desktop"></div>
	<div class="gradient gradient--mobile"></div>
</div>
<span class="tag">{event.photoCaption}</span>

<style>
	.bg {
		position: absolute;
		inset: 0;
		overflow: hidden;
		z-index: 0;
	}

	.bg :global(picture) {
		position: absolute;
		inset: 0;
	}

	.bg :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 60% 35%;
		transform: scale(1.08);
		animation: hero-zoom 2.4s var(--ease-out) forwards;
	}

	@keyframes hero-zoom {
		to {
			transform: scale(1);
		}
	}

	.tint {
		position: absolute;
		inset: 0;
		background: var(--fen-green-850);
		mix-blend-mode: multiply;
		opacity: 0.28;
	}

	.gradient {
		position: absolute;
		inset: 0;
	}

	.gradient--desktop {
		background:
			linear-gradient(
				to right,
				rgba(31, 59, 28, 0.92) 0%,
				rgba(31, 59, 28, 0.72) 34%,
				rgba(31, 59, 28, 0.18) 62%,
				rgba(31, 59, 28, 0.05) 100%
			),
			linear-gradient(to bottom, rgba(31, 59, 28, 0) 0%, var(--fen-green-950) 100%);
	}

	.gradient--mobile {
		display: none;
	}

	.tag {
		position: absolute;
		top: 24px;
		right: var(--gutter);
		z-index: 1;
		padding: 6px 10px;
		border-radius: var(--r-6);
		background: rgba(31, 59, 28, 0.72);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		font-size: 12px;
		color: var(--fen-on-dark);
	}

	@media (max-width: 1024px) {
		.gradient--desktop {
			display: none;
		}

		.gradient--mobile {
			display: block;
			background: linear-gradient(
				to bottom,
				rgba(31, 59, 28, 0.15) 0%,
				rgba(31, 59, 28, 0.4) 55%,
				var(--fen-green-950) 100%
			);
		}

		.bg :global(img) {
			object-position: 68% 30%;
		}

		.tag {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bg :global(img) {
			animation: none;
			transform: scale(1);
		}
	}
</style>
