---
import { faqIntro, faqSectionTitle, faqItems } from '../../data/faq';
---

<section class="faq" aria-labelledby="faq-title">
	<div class="wrap">
		<div class="intro">
			<h2>{faqIntro.title}</h2>
			<p>{faqIntro.body}</p>
		</div>

		<div class="section-title">
			<h3 id="faq-title">{faqSectionTitle}</h3>
			<span class="underline" aria-hidden="true"><span class="a"></span><span class="b"></span></span>
		</div>

		<faq-accordion class="acc-list">
			{
				faqItems.map((item, i) => (
					<div class:list={['acc-item', { 'is-open': item.defaultOpen }]}>
						<h4>
							<button
								type="button"
								class="acc-btn"
								aria-expanded={item.defaultOpen ? 'true' : 'false'}
								aria-controls={`faq-panel-${i}`}
								id={`faq-btn-${i}`}
							>
								<span>{item.question}</span>
								<span class="acc-ring" aria-hidden="true">
									<svg
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									>
										<path d="M6 9l6 6 6-6" />
									</svg>
								</span>
							</button>
						</h4>
						<div class="acc-panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
							<div>
								<p>{item.answer}</p>
							</div>
						</div>
					</div>
				))
			}
		</faq-accordion>
	</div>
</section>

<style>
	.faq {
		background: var(--plate);
		padding: 88px 0;
	}

	.wrap {
		max-width: 820px;
		margin: 0 auto;
		padding: 0 var(--gutter);
	}

	.intro {
		max-width: 640px;
		margin: 0 auto 64px;
		text-align: center;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.intro h2 {
		margin: 0;
		font-weight: 700;
		font-size: clamp(24px, 2.6vw, 30px);
		line-height: 1.35;
		color: #fff;
	}

	.intro p {
		margin: 0;
		font-size: 15px;
		line-height: 1.65;
		color: #fff;
	}

	.section-title {
		text-align: center;
		margin-bottom: 36px;
	}

	.section-title h3 {
		margin: 0;
		font-weight: 700;
		font-size: clamp(26px, 3vw, 32px);
		color: #fff;
	}

	.underline {
		display: flex;
		justify-content: center;
		gap: 4px;
		margin-top: 10px;
	}

	.underline span {
		height: 3px;
		width: 34px;
		border-radius: 3px;
	}

	.underline .a {
		background: var(--fen-green-950);
	}

	.underline .b {
		background: var(--fen-accent);
	}

	.acc-list {
		display: flex;
		flex-direction: column;
	}

	.acc-item {
		border-bottom: 1px solid var(--fen-line);
	}

	.acc-item:first-child {
		border-top: 1px solid var(--fen-line);
	}

	.acc-item h4 {
		margin: 0;
	}

	.acc-btn {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 24px 4px;
		border: none;
		background: transparent;
		text-align: left;
		font-family: var(--fen-font);
		cursor: pointer;
	}

	.acc-btn span:first-child {
		font-weight: 600;
		font-size: 17px;
		line-height: 1.4;
		color: #fff;
	}

	.acc-ring {
		flex-shrink: 0;
		width: 34px;
		height: 34px;
		border-radius: var(--r-pill);
		border: 1px solid var(--fen-stone);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #fff;
		transition:
			background-color 220ms var(--ease-out),
			border-color 220ms var(--ease-out);
	}

	.acc-btn[aria-expanded='true'] .acc-ring {
		background: #fff;
		border-color: #fff;
		color: var(--fen-green-900);
	}

	.acc-ring svg {
		transition: transform 220ms var(--ease-spring);
	}

	.acc-btn[aria-expanded='true'] .acc-ring svg {
		transform: rotate(180deg);
	}

	.acc-panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 280ms var(--ease-out);
	}

	.acc-panel > div {
		overflow: hidden;
	}

	.acc-item.is-open .acc-panel {
		grid-template-rows: 1fr;
	}

	.acc-panel p {
		margin: 0;
		padding: 0 4px 26px;
		max-width: 640px;
		font-size: 14.5px;
		line-height: 1.65;
		color: #fff;
	}

	@media (max-width: 760px) {
		.acc-btn span:first-child {
			font-size: 16px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.acc-panel,
		.acc-ring,
		.acc-ring svg {
			transition-duration: 1ms !important;
		}
	}

	@media (scripting: none) {
		.acc-panel {
			grid-template-rows: 1fr !important;
		}
	}
</style>

<script>
	class FaqAccordion extends HTMLElement {
		private wired = false;

		connectedCallback() {
			if (this.wired) return;
			this.wired = true;

			const items = Array.from(this.querySelectorAll<HTMLElement>('.acc-item'));

			items.forEach((item) => {
				const btn = item.querySelector<HTMLButtonElement>('.acc-btn');
				if (!btn) return;

				btn.addEventListener('click', () => {
					const wasOpen = item.classList.contains('is-open');

					items.forEach((i) => {
						i.classList.remove('is-open');
						i.querySelector('.acc-btn')?.setAttribute('aria-expanded', 'false');
					});

					if (!wasOpen) {
						item.classList.add('is-open');
						btn.setAttribute('aria-expanded', 'true');
					}
				});
			});
		}
	}

	customElements.define('faq-accordion', FaqAccordion);
</script>
